# ==============================================================
# 思维棱镜原型 - 环境变量配置
# ⚠️ 安全提示：此文件可以提交到版本控制，但绝不要填入真实的 API Key！
# 使用方法：复制此文件为 .env，然后在 .env 中填入真实配置
#   cp .env.example .env
# ==============================================================

# LLM 配置（支持任何 OpenAI 兼容接口）
# 默认使用 DeepSeek（性价比最优，中文能力强）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat

# 服务器端口
PORT=3000

# 数据存储目录（默认在 prototype/data/ 下，自动创建，已加入 .gitignore）
# DATA_DIR=./data

# === 其他 LLM 配置示例 ===

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini

# 硅基流动（SiliconFlow，国内低延迟）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-ai/DeepSeek-V3

# 月之暗面（Moonshot）
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=moonshot-v1-8k
